# Keep application source, runtime assets, docs, pubspec.lock, Flutter metadata,
# Gradle configuration and both Gradle wrappers in version control.

# Flutter / Dart generated files and package caches
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
.pub-cache/
**/build/
/coverage/
**/doc/api/
.widget_preview/
app.*.symbols
app.*.map.json

# Gradle, Android and native build caches
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
/android/captures/
/android/app/debug/
/android/app/profile/
/android/app/release/
**/GeneratedPluginRegistrant.java
*.class
*.dex
*.apk
*.aab
*.ap_
*.hprof

# Machine-specific SDK paths and private signing configuration
local.properties
key.properties
keystore.properties
*.keystore
*.jks
*.p12
*.pfx
.env
.env.*
!.env.example
!.env.sample

# IDE-local settings (shared .vscode tasks/launch configuration may be committed)
.idea/
*.iml
*.ipr
*.iws
.history/

# Python tools: generated bytecode and local environments
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# APK inspection dumps, emulator captures and generated review/build logs.
# Keep the maintained project reports referenced by README.md.
/analysis/*
!/analysis/FEATURES.md
!/analysis/TRACKERS.md
!/analysis/VALIDATION.md
!/analysis/LOCAL_UI_REVIEW.md

# OS files, temporary files and crash dumps
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.temp
*.swp
*.swo
*~
*.dmp
./gradle
**/assets/*