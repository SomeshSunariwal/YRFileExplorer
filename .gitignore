!/pubspec.yaml
!/pubspec.lock
!/analysis_options.yaml
!/lib/
!/android/
!/assets/
!/docs/
!/gradle/
!/gradlew
!/gradlew.bat
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/run.ps1
!/run.cmd

